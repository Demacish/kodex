# Copy to .env and fill in before running `docker compose up`.

# Any variable here can come from a file instead: NAME_FILE=/run/secrets/name
# sets NAME from that file's content (Docker and Podman secrets), e.g.
# SECRET_KEY_FILE, OIDC_CLIENT_SECRET_FILE, SMTP_PASSWORD_FILE (docs/configuration.md).

# The server's image. By default the newest release; a version
# (ghcr.io/demacish/kodex:2.0.0) stays put until you change it, and :edge
# follows the main branch. See docs/operations.md on upgrading.
# KODEX_IMAGE=ghcr.io/demacish/kodex:latest

# Who the server runs as, and so who owns what it writes in the libraries
# and volumes: your user's `id -u` and `id -g` on a NAS. 0 keeps it root,
# for libraries only root can read.
PUID=1000
PGID=1000

# Nightly database dumps kept in the backups volume (0: none). See docs/operations.md.
BACKUP_KEEP=7

# Postgres password for the db/api/worker services.
POSTGRES_PASSWORD=change-me

# Absolute path on the host to the folder containing your library
# subfolders (e.g. comics/, books/, manga/). Mounted into the api and
# worker containers as /libraries.
LIBRARIES_HOST_PATH=/path/to/libraries
# Where the sorting assistant moves sorted files to (mounted as
# /libraries/_sorterat). Must be a separate folder from the one above.
SORTED_LIBRARY_HOST_PATH=/path/to/libraries-sorted

# Host port of the api, which also serves the web client (bound to
# 127.0.0.1; put a reverse proxy with TLS in front).
API_PORT=8000

# --- Auth ---
# Set to true ONLY for local development: every request is a fixed dev user.
# Never set this in a real deployment.
AUTH_DISABLED=false

# Accounts live in Kodex: the first visit to a server without users
# creates the admin, who adds the others and hands each a one-time
# sign-in link (or set a password from the command line:
# python -m kodex.core.auth.cli set-password NAME). Users can add passkeys
# and turn on two-step login (an authenticator app) under Inställningar.
# false turns passwords and passkeys off, leaving the provider below.
LOCAL_LOGIN_ENABLED=true
PASSKEYS_ENABLED=true
SESSION_DAYS=30
# Behind a reverse proxy, let uvicorn trust its X-Forwarded-For/-Proto
# (the proxy's address, or * when only the proxy can reach the api), so
# failed-login limits apply per client and cookies are marked Secure.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: log in through an OpenID Connect provider as well (Authentik,
# Keycloak, Authelia, Zitadel, Pocket ID, ...). The provider must allow
# <this server>/api/auth/oidc/callback as a redirect URI; apps may also
# send its access tokens as bearer tokens. Users are matched by the
# token's subject, and anyone can link their Kodex account to it under
# Inställningar. Leave OIDC_ISSUER empty to use only Kodex's own accounts.
# (v1's AUTHENTIK_* names for these still work.)
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Empty for a public client (PKCE only).
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
OIDC_DISPLAY_NAME=
OIDC_GROUPS_CLAIM=groups
# Only members of this group may log in (empty: everyone the provider
# lets through); with an admin group, membership decides who is an admin.
OIDC_REQUIRED_GROUP=
OIDC_ADMIN_GROUP=
# Whether a first login through the provider creates a Kodex account;
# false lets in only accounts that were linked.
OIDC_CREATE_USERS=true
# Optional: a second client at the same provider whose tokens apps send
# (v1's Android app uses its own public client at Authentik). Leave both
# empty if there is none.
OIDC_MOBILE_CLIENT_ID=
OIDC_MOBILE_ISSUER=

# --- Encryption at rest ---
# Encrypts the authenticator secrets of two-step login and the users'
# tracker tokens, so a copy of the database alone opens neither. Any long
# random string (openssl rand -base64 32), set once: with a new key, what
# the old one encrypted can't be read, and people have to set up two-step
# login and their trackers again. Empty: those are stored as they are.
SECRET_KEY=

# --- Trackers: MangaUpdates, Kitsu, AniList, MyAnimeList (docs/clients.md) ---
# Need SECRET_KEY above. AniList and MyAnimeList also need a client
# registered with them (free): AniList under Settings → Developer,
# MyAnimeList at myanimelist.net/apiconfig. Register
# <this server>/api/trackers/anilist/callback (or .../myanimelist/callback)
# as the redirect URI. Empty leaves the service out; MangaUpdates and Kitsu
# need nothing here.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MYANIMELIST_CLIENT_ID=
MYANIMELIST_CLIENT_SECRET=

# --- Send to Kindle ---
# A mail account Kodex sends books from. Kindle only accepts mail from
# addresses on the reader's approved list, so add SMTP_FROM_ADDRESS there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Metadata enrichment ---
# Free key from https://comicvine.gamespot.com/api/. Leave empty to skip
# Comic Vine enrichment entirely (comics libraries just won't get
# auto-enriched, but manual matching against other providers still works).
COMICVINE_API_KEY=
# Optional: your own Metron account (https://metron.cloud/), used on top of
# a Comic Vine match for story arcs and cover hashes (Comic Vine's own arc
# data is sparse). Leave both empty to skip Metron.
METRON_USERNAME=
METRON_PASSWORD=
# Open Library and AniList both ask API consumers to identify themselves —
# put a real contact so they can reach you if something needs attention.
ENRICHMENT_USER_AGENT=kodex (https://example.com) contact: you@example.com
# Optional: Hardcover API token (e-book editions by ISBN).
HARDCOVER_API_TOKEN=
# Match new series automatically after a scan (kodex.matching). The review
# queue under Admin › Granskning shows what needs a decision.
MATCH_AFTER_SCAN=true
# Optional: a TOML file overriding values in backend/kodex/matching/matching.toml.
KODEX_MATCHING_CONFIG=

# --- Scanning and background jobs ---
# Processes a scan reads new and changed files with (0 = one per CPU).
SCAN_WORKERS=0
# Libraries are rescanned when this long has passed since their last scan;
# the polling network shares need. 0 turns it off.
RESCAN_INTERVAL_MINUTES=60
# How long ended jobs stay in the admin job view.
JOB_RETENTION_DAYS=14

# --- Notifications to the admins about new requests ---
# Optional, and independent of each other: fill in one, both or neither.
# Without them, new requests still wait in the admins' queue (Önskemål),
# just without a message.
#
# Telegram: create a bot with @BotFather (it gives you the token), send the
# bot any message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server Settings → Integrations → Webhooks → New Webhook, and
# paste its URL here.
DISCORD_WEBHOOK_URL=

# --- Guided view (panel-by-panel reading of comics, experimental) ---
# Turns the whole feature off or on without a new deploy: false queues no
# panel detection and answers every request for a page's panels with an
# empty list, whatever is stored. Its reading order isn't reliable yet, so
# the example turns it off.
GUIDED_VIEW_ENABLED=false

# --- Sorting the intake library (the first library of type "mixed") ---
# A scan of the intake puts new folders and files in the sorting queue.
# true: those Kodex is sure of (a ComicInfo.xml, or a clear file name such
# as "c012" for manga or "001 (2024)" for comics) are moved into the
# comics, manga and book libraries right away; the rest wait under
# Admin › Import. false: nothing moves until someone applies the sorting.
SORTING_AUTO_APPLY=true

# --- Sharing reading progress with a central Kodex server ---
# Set these on every server EXCEPT the central one. The address is the
# central server's /kosync (the address KOReader uses), and the account a
# username and KOReader key there. Everyone on this server syncs as that
# account. Books are recognised by their file hash, so the same file on two
# servers shares its progress. Empty: no syncing.
PROGRESS_SYNC_URL=
PROGRESS_SYNC_USERNAME=
PROGRESS_SYNC_TOKEN=
# How this server shows up as a device on the central one, e.g. Home NAS.
PROGRESS_SYNC_DEVICE_NAME=

# --- Push notifications through ntfy (also a UnifiedPush distributor) ---
# Each user picks their own topic under Inställningar; this is the ntfy
# server the topics are on, ntfy.sh or your own. NTFY_TOKEN is only needed
# if that server requires a login to publish.
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
# The address people use, e.g. https://kodex.example.com. It makes
# notifications open the series, and it is the address in sign-in links
# and the OIDC redirect; passkeys belong to its host name. Empty: the host
# name the browser used.
PUBLIC_APP_URL=

# --- Other Kodex servers (see what is where, copy books there) ---
# A JSON list of the other servers: url is the other server's address
# (over a VPN, say), upload_key that server's UPLOAD_API_KEY, which it must
# have set. For example:
# KODEX_PEERS=[{"name": "Home NAS", "url": "http://nas.example.lan:8000", "upload_key": "..."}]
KODEX_PEERS=

# --- Statistics for a dashboard widget (GET /stats) ---
# A fixed key a dashboard sends in X-Kodex-Api-Key (generate one with e.g.
# `openssl rand -hex 24`). Admins see the statistics in the web client
# without it; empty turns the key off.
STATS_API_KEY=

# --- AI suggestions ("För dig") and AI collections ---
# One key for the whole server, set by the admin. An empty AI_PROVIDER
# turns off both the suggestions on the home page and Discover, and the
# admin's "Bygg AI-samling".
# AI_PROVIDER: "openai" | "claude" | "gemini".
AI_PROVIDER=
AI_API_KEY=
# Optional: empty uses the provider's default model.
AI_MODEL=

# --- Acquisition, an add-on that is off by default (docs/acquire.md) ---
# true: an approved request for a missing issue is searched for in Prowlarr,
# downloaded with qBittorrent or SABnzbd, imported into its series' folder
# and scanned. Needs PROWLARR_* and QBITTORRENT_* or SABNZBD_* below.
ACQUIRE_ENABLED=false

# --- Download clients ---
# All optional, and all running somewhere else: the compose file starts
# none of them. An empty QBITTORRENT_URL, SABNZBD_URL or PROWLARR_URL
# leaves that one out.
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
SABNZBD_URL=
SABNZBD_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
FLARESOLVERR_URL=
# The shared secret in the call a download client makes when a download is
# done (POST /downloads/{id}/webhook-complete?token=...). Empty: the
# webhook refuses every call.
DOWNLOAD_WEBHOOK_SECRET=
# "client_prefix:container_prefix": turns the download client's own path
# into the one Kodex's worker container sees. Empty: no translation.
DOWNLOAD_PATH_MAP_TORRENT=
DOWNLOAD_PATH_MAP_USENET=
# Where finished downloads wait before they are moved into their library.
DOWNLOADS_STAGING_DIR=/data/downloads
# Anna's Archive: mirrors to try, in order, comma-separated.
ANNAS_ARCHIVE_MIRRORS=

# --- Mylar3 and Kapowarr ---
# Series managers running on a host of their own. Kodex only tells them
# which Comic Vine volume to start following (for now through the API:
# POST /api/requests/{id}/send-to-mylar3 or send-to-kapowarr); they search,
# download and organise on their own. Their finished files come into Kodex
# through a script on that host that uploads them
# (POST /api/libraries/{id}/upload, with UPLOAD_API_KEY below).
MYLAR3_URL=
MYLAR3_API_KEY=
KAPOWARR_URL=
KAPOWARR_API_KEY=
# One of Kapowarr's own root folders (its GET /api/rootfolder lists their
# ids). There is no sensible default: set it by hand.
KAPOWARR_ROOT_FOLDER_ID=
# The key scripts and other Kodex servers upload into the libraries with
# (sent as X-Kodex-Upload-Key), as they can't log in through a browser.
# Empty turns that way off; admins can still upload in the web client.
UPLOAD_API_KEY=
